  <Body>
    <ReportItems>
      <Textbox Name="Textbox2">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Pelo presente, eu </Value>
                <Style>
                  <FontSize>12pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value>=Parameters!Nome.Value</Value>
                <Style>
                  <FontSize>12pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value> de matrícula No. </Value>
                <Style>
                  <FontSize>12pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value>=Parameters!Matricula.Value</Value>
                <Style>
                  <FontSize>12pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value>, e CPF No. </Value>
                <Style>
                  <FontSize>12pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value>=Parameters!CPF.Value</Value>
                <Style>
                  <FontSize>12pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value> venho solicitar um adiantamento no valor de R$ </Value>
                <Style>
                  <FontSize>12pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value>=Parameters!Valor.Value</Value>
                <Style>
                  <FontSize>12pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value> ( </Value>
                <Style>
                  <FontSize>12pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value>=Parameters!Extenso.Value</Value>
                <Style>
                  <FontSize>12pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value> ), que será pago em </Value>
                <Style>
                  <FontSize>12pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value>=Parameters!Parcelas.Value</Value>
                <Style>
                  <FontSize>12pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value> ( </Value>
                <Style>
                  <FontSize>12pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value>=Parameters!ExtensoParcelas.Value</Value>
                <Style>
                  <FontSize>12pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value> ) </Value>
                <Style>
                  <FontSize>12pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value>=IIF(Parameters!Parcelas.Value.Equals("1"),"parcela mensal","parcelas mensais")</Value>
                <Style>
                  <FontSize>12pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value> de igual valor R$ </Value>
                <Style>
                  <FontSize>12pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value>=Parameters!ValorParcela.Value</Value>
                <Style>
                  <FontSize>12pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value> (</Value>
                <Style>
                  <FontSize>12pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value>=Parameters!ExtensoValorParcela.Value</Value>
                <Style>
                  <FontSize>12pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value>) .</Value>
                <Style>
                  <FontSize>12pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value />
                <Style>
                  <FontSize>12pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value />
                <Style>
                  <FontSize>12pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Sendo assim, autorizo o pagamento do adiantamento supra solicitado, no número de prestações acima, e o desconto em minha folha de pagamento, em conformidade com o calendário do sistema de consignação.</Value>
                <Style>
                  <FontSize>12pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
